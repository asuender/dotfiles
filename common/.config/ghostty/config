window-width = 110
window-height = 35

window-padding-x = 10
window-padding-y = 10,0
window-padding-color = background

font-family = CaskaydiaCove Nerd Font Mono
font-size = 18
adjust-cell-width = -5%

keybind = shift+enter=text:\n

theme = dark:Catppuccin Macchiato,light:Catppuccin Latte

# from: https://github.com/sahaj-b/ghostty-cursor-shaders
# custom-shader = cursor_warp.glsl

# Copy Ghostty's terminfo to new remote machines
shell-integration-features = ssh-terminfo
# Fallback if terminfo installation fails
shell-integration-features = ssh-env

# This ensures I can press Alt-1,2,... for tmux
macos-option-as-alt = right

