#!/usr/bin/env bash
set -euo pipefail

session=$(tmux display-message -p '#{session_name}')
cwd=$(tmux display-message -p '#{pane_current_path}')

has_window() {
  tmux list-windows -t "$session" -F '#{window_name}' | grep -qx "$1"
}

get_window_index() {
  tmux list-windows -t "$session" -F '#{window_name} #{window_index}' |
    awk -v n="$1" '$1==n {print $2}'
}

# Create any missing windows
has_window "shell" || tmux new-window -t "$session" -n "shell" -c "$cwd"
has_window "nvim" || tmux new-window -t "$session" -n "nvim" -c "$cwd" "nvim ."
has_window "opencode" || tmux new-window -t "$session" -n "opencode" -c "$cwd" "opencode --port"

# Ensure order: shell=1, nvim=2, opencode=3
# Re-query the index each time since swaps shift positions.
place_window() {
  local name="$1" target="$2"
  local current
  current=$(get_window_index "$name")
  if [ "$current" != "$target" ]; then
    tmux swap-window -s "$session:$current" -t "$session:$target"
  fi
}

place_window "shell" 1
place_window "nvim" 2
place_window "opencode" 3

tmux select-window -t "$session:1"
